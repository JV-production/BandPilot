# Databáze (SQLite pro vývoj; pro produkci lze přepnout na PostgreSQL v prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="vygenerujte-pomoci-openssl-rand-base64-32"

# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials)
# Povolte "Google Calendar API" a jako redirect URI nastavte:
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# E-maily organizátorů (oddělené čárkou) – po přihlášení dostanou roli ADMIN
ADMIN_EMAILS="organizator@example.com"

# Časové pásmo pro zadávání a zobrazování časů
APP_TIMEZONE="Europe/Prague"

# Vývojové přihlášení jen e-mailem (NIKDY nezapínat v produkci)
ENABLE_DEV_LOGIN="false"
