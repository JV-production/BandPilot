{
  "name": "bandpilot",
  "version": "0.1.0",
  "private": true,
  "description": "Správa a organizace hudebních kapel – koncerty, sestavy, doprava, hlasování a synchronizace s Google Kalendářem.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
